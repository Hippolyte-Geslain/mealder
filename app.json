{
  "expo": {
    "name": "MealMatch",
    "slug": "mealder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F1E3"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hippogagne.mealder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F1E3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MealMatch a besoin d'accéder à vos photos pour illustrer vos recettes.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "61d6e2a7-57b3-4c23-aefd-ebba9c69cd04"
      }
    },
    "owner": "hippogagne"
  }
}
