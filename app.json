{
  "expo": {
    "name": "MealMatch",
    "slug": "mealder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F1E3"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mealder.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F1E3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MealMatch a besoin d'accéder à vos photos pour illustrer vos recettes."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "61d6e2a7-57b3-4c23-aefd-ebba9c69cd04"
      }
    },
    "owner": "hippogagne",
    "updates": {
      "url": "https://u.expo.dev/61d6e2a7-57b3-4c23-aefd-ebba9c69cd04"
    }
  }
}
